DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# IANA timezone used to bucket sales into days / months / years in reports
TIMEZONE=Asia/Kolkata
# Create tables on startup (fine for a single shop; use Alembic migrations if the schema will evolve)
AUTO_CREATE_TABLES=true
